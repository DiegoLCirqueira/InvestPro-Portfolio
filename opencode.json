{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git reset --hard*": "ask",
      "git clean -fdx*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git pull --rebase --autostash*": "ask",
      "prisma migrate reset*": "ask",
      "prisma db push --force-reset*": "ask",
      "prisma db reset*": "ask",
      "*DROP DATABASE*": "ask",
      "*DROP TABLE*": "ask",
      "*DROP SCHEMA*": "ask",
      "*TRUNCATE *CASCADE*": "ask",
      "rm -rf *": "ask",
      "Remove-Item * -Recurse -Force*": "ask",
      "npm publish*": "ask",
      "terraform destroy*": "ask",
      "* deploy* prod*": "ask",
      "* setx *POSTGRES*PASSWORD*": "ask",
      "*Update-Password*": "ask"
    }
  }
}
