{
  "name": "investpro",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspace=packages/web",
    "lint": "npm run lint --workspace=packages/web",
    "preview": "npm run preview --workspace=packages/web",
    "test": "npm run test --workspaces --if-present",
    "clean": "rimraf node_modules packages/*/node_modules"
  }
}
