# ============================================================
# InvestPro — variáveis de ambiente (monorepo)
# Backend: copie para packages/server/.env
# Frontend: o Vite lê automaticamente .env na raiz de packages/web
# ============================================================

# ---- Backend (packages/server) ----
# PostgreSQL. No Railway é fornecida automaticamente pelo serviço de database.
# Em produção adicione o parâmetro sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investpro?schema=public"

# Segredos. Em produção gere valores longos e aleatórios (ex.: openssl rand -hex 64).
JWT_SECRET="investpro-dev-jwt-secret-2024"
JWT_REFRESH_SECRET="investpro-dev-refresh-secret-2024"

# Porta HTTP de escuta. O Railway injeta automaticamente a variável PORT.
PORT=3001

# development | production
NODE_ENV=development

# Origem(ns) do frontend permitida(s) no CORS. UMA origem, ou VÁRIAS separadas por vírgula (ex.: durante a migração de domínio: "https://investpro1-five.vercel.app,https://investpro.dev.br"). Cada item é uma origem EXATA: esquema http/https + host [+ porta], sem barra final, caminho, credenciais nem curinga. Em produção é obrigatória e não pode ser o localhost padrão nem conter '*'; lista inválida derruba o boot.
CORS_ORIGIN="http://localhost:5173"

# URL do frontend usada para montar o link de reset de senha (nunca deriva do header Host/Origin).
FRONTEND_URL="http://localhost:5173"

# Chave da API do Resend (resend.com), para envio de email transacional (reset de senha, etc.).
RESEND_API_KEY=""

# Remetente dos emails via Resend. Requer domínio verificado no Resend em produção.
RESEND_FROM_EMAIL="InvestPro <onboarding@resend.dev>"

# Token da API da Brapi (brapi.dev), para cotações de ações brasileiras (PETR4, VALE3, etc.).
# Sem ele, a fonte Brapi responde 401 e o serviço cai no fallback/cache.
BRAPI_API_KEY=""
# Peers (IP/CIDR/loopback/linklocal/uniquelocal, separados por vírgula) em que o Fastify confia pra ler o IP do cliente no X-Forwarded-For (rate limit por IP). Vazio = padrão: rede interna do proxy da Railway em produção, ninguém em desenvolvimento. "false" desliga. Ver docs/deploy-backend.md.
TRUST_PROXY=
# Câmbio: a cotação viva (AwesomeAPI) é reaproveitada por este tempo sem chamar a API (reduz os 429). Padrão 30, faixa 0-300.
EXCHANGE_RATE_FRESH_TTL_SECONDS=
# Câmbio: em falha/429 da fonte, serve a última cotação só se tiver no máximo esta idade; além disso o câmbio responde 503 (nunca taxa estática). Padrão 120, faixa 1-600 (teto rígido), >= o TTL fresco.
EXCHANGE_RATE_MAX_AGE_SECONDS=
# Câmbio executado: idade máxima da cotação aceita no POST /exchange/execute (mais curta que a da simulação). Padrão 60, faixa 1-600, deve ser <= EXCHANGE_RATE_MAX_AGE_SECONDS. Mais velha => 503 EXCHANGE_RATE_UNAVAILABLE.
EXCHANGE_EXECUTE_MAX_AGE_SECONDS=
# Câmbio: cotação nova que desvia mais que este percentual da última boa em cache do mesmo par é rejeitada (tratada como falha da fonte). Padrão 15, faixa 1-100.
EXCHANGE_RATE_MAX_DEVIATION_PERCENT=
# Refresh token: por quantos segundos após a rotação a reapresentação do token antigo (abas/recarga simultâneas) NÃO derruba a sessão. Padrão 10, faixa 0-30 (0 desliga).
REFRESH_REUSE_GRACE_SECONDS=
# Refresh token: rotação preguiçosa. O token só é trocado (novo cookie) quando tem mais que isso de idade; antes, /auth/refresh só renova o access token e reusa o mesmo cookie (recargas rápidas). Padrão 600 (10 min), faixa 0-900 (o TTL do access token); 0 = rotacionar sempre.
REFRESH_ROTATE_AFTER_SECONDS=
# Seed (prisma/seed.ts) — só desenvolvimento/CI, NUNCA em produção. Sem senha fixa no repositório: SEED_ADMIN_PASSWORD e SEED_USER_PASSWORD (mínimo 12 caracteres) são opcionais; se ausentes, o seed gera uma senha aleatória e a mostra UMA vez no console, só quando cria a conta. Conta que já existe não tem a senha alterada.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# O seed recusa rodar com NODE_ENV=production. Só defina isto, de propósito, para autorizar uma execução em produção (não recomendado: ele cria conta de demonstração com saldo). Deixe fora do ambiente.
# SEED_ALLOW_PRODUCTION=true

# ---- Frontend (packages/web) ----
# URL base da API consumida pelo frontend em tempo de build.
VITE_API_URL="http://localhost:3001/api/v1"