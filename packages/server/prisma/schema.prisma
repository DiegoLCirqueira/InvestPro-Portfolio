generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  passwordHash         String
  fullName             String
  cpf                  String?              @unique
  phone                String?
  role                 Role                 @default(USER)
  // Perfil de investidor (questionário). Pontuação e data guardadas para auditoria.
  investorProfile      InvestorProfile?
  investorProfileScore Int?
  investorProfileAt    DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  portfolio            Portfolio?
  refreshTokens        RefreshToken[]
  bankAccounts         BankAccount[]
  transfers            Transfer[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  topUpsReceived       BalanceTopUp[]       @relation("TopUpReceiver")
  topUpsActed          BalanceTopUp[]       @relation("TopUpActor")
  savingsBox           SavingsBox?
  currencyHoldings     CurrencyHolding[]
  currencyExchanges    CurrencyExchange[]
  portfolioSnapshots   PortfolioSnapshot[]
}

// Portfolio/Position: dado financeiro (saldo, posições de investimento) sujeito a
// retenção/auditoria. Deletar um User NÃO pode apagar isso silenciosamente, então a
// FK é Restrict (bloqueia o delete físico do User enquanto o Portfolio existir) e o
// "delete" de fato é lógico via deletedAt. RefreshToken/PasswordResetToken/BankAccount
// permanecem CASCADE — não são histórico financeiro. Ver ADR 0001.
model Portfolio {
  id        String     @id @default(uuid())
  userId    String     @unique
  balance   Decimal    @default(0) @db.Decimal(15, 2)
  deletedAt DateTime?
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  positions Position[]
}

model Position {
  id           String    @id @default(uuid())
  portfolioId  String
  ticker       String
  name         String
  type         AssetType
  quantity     Decimal   @db.Decimal(15, 8)
  avgPrice     Decimal   @db.Decimal(15, 2)
  currentValue Decimal   @db.Decimal(15, 2)
  deletedAt    DateTime?
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, ticker])
}

// Caixinha (rendimento fixo simulado, demo): saldo separado do Portfolio.balance,
// 1:1 com User igual Portfolio. Mesmo tratamento de retenção financeira do ADR
// 0001 (Restrict + deletedAt) — é dinheiro do usuário, mesma categoria de
// Portfolio/Position, só que num "pote" separado. Modelo próprio em vez de um
// campo em Portfolio para não conflar dois saldos com semânticas diferentes na
// mesma linha e já deixar isolado pra uma futura tabela de auditoria de
// depósito/resgate/rendimento (mesmo padrão de BalanceTopUp), sem precisar
// migrar de coluna solta pra tabela depois.
model SavingsBox {
  id        String    @id @default(uuid())
  userId    String    @unique
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  // Agrupa todos os tokens da mesma cadeia de rotação (WI-27: detecção de
  // reuso). Preservado a cada rotação, não muda até o próximo login.
  familyId   String
  // "Lembrar de mim": true = 30 dias, false = 7 dias (padrão). Decidido uma
  // vez no login e propagado a cada rotação da mesma família.
  rememberMe Boolean   @default(false)
  // null = token ativo. Setado quando o token é rotacionado (uso normal),
  // usado no logout, ou invalidado por troca de senha/reuso detectado. Um
  // token com revokedAt preenchido sendo reapresentado é o sinal de reuso.
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id         String   @id @default(uuid())
  userId     String
  bank       String
  agency     String
  account    String
  holderName String?
  type       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transfer {
  id              String         @id @default(uuid())
  userId          String
  status          TransferStatus @default(PENDING)
  type            TransferType
  amount          Decimal        @db.Decimal(15, 2)
  description     String?
  toAccountBank   String?
  toAccountAgency String?
  toAccountNumber String?
  toAccountHolder String?
  toAccountId     String?
  toAccountType   String?
  pixKey          String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  failureReason   String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, createdAt])
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  assetId    String
  ticker     String
  side       OrderSide
  type       OrderType
  quantity   Decimal     @db.Decimal(15, 8)
  price      Decimal?    @db.Decimal(15, 2)
  status     OrderStatus @default(PENDING)
  avgPrice   Decimal?    @db.Decimal(15, 2)
  createdAt  DateTime    @default(now())
  executedAt DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// Auditoria do top-up simulado (demo, sem Transfer/Order associado): registra
// quem recebeu o crédito, quem executou a ação (pode divergir quando um ADMIN
// credita a conta de outro usuário) e o saldo resultante. Restrict nos dois
// FKs, mesmo tratamento de histórico financeiro dado a Order/Transfer.
model BalanceTopUp {
  id           String   @id @default(uuid())
  userId       String
  actorUserId  String
  amount       Decimal  @db.Decimal(15, 2)
  balanceAfter Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  user         User     @relation("TopUpReceiver", fields: [userId], references: [id], onDelete: Restrict)
  actor        User     @relation("TopUpActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// Carteira de moedas: quanto o usuário tem de cada moeda estrangeira, fora do
// Portfolio.balance (que é sempre BRL). Mesmo tratamento de retenção financeira
// do ADR 0001 (Restrict + deletedAt) — é holding de ativo, mesma categoria de
// Position. unique(userId, currency) já serve de índice pra "todas as moedas
// do usuário" (prefixo esquerdo), sem precisar de @@index([userId]) redundante.
model CurrencyHolding {
  id        String    @id @default(uuid())
  userId    String
  currency  Currency
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, currency])
}

// Auditoria de cada execução de câmbio (debita fromCurrency, credita
// toCurrency) — mesmo padrão de BalanceTopUp: registro append-only, direto em
// User (não em CurrencyHolding), porque uma execução mexe em duas contas ao
// mesmo tempo (Portfolio.balance ou outro CurrencyHolding de origem + o
// CurrencyHolding de destino). rate em Decimal(15,8): taxa de câmbio precisa de
// mais casas que valor monetário puro (mesma razão de Position.quantity).
model CurrencyExchange {
  id              String   @id @default(uuid())
  userId          String
  fromCurrency    Currency
  toCurrency      Currency
  amount          Decimal  @db.Decimal(15, 2)
  convertedAmount Decimal  @db.Decimal(15, 2)
  rate            Decimal  @db.Decimal(15, 8)
  fee             Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum TransferType {
  PIX
  TED
  DOC
}

// Fotografia do patrimônio total (caixa + posições + caixinha + moedas em BRL)
// num instante: base do gráfico "Evolução do Patrimônio" e das métricas de
// risco. netFlow é o dinheiro que ENTROU (+, aporte) ou SAIU (-, transferência)
// da plataforma naquele evento: separa aporte de rendimento no cálculo da
// rentabilidade. Movimentos internos (ordem, câmbio, caixinha) têm netFlow 0.
// Restrict como o resto do histórico financeiro (ADR 0001).
model PortfolioSnapshot {
  id        String         @id @default(uuid())
  userId    String
  equity    Decimal        @db.Decimal(15, 2)
  netFlow   Decimal        @default(0) @db.Decimal(15, 2)
  reason    SnapshotReason
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// SIGNUP: abertura da conta, com o saldo inicial como aporte.
// DAILY: registro diário ao abrir o painel. BACKFILL: reconstruído dos aportes e
// transferências já registrados (sem variação de mercado) para contas anteriores
// a esta tabela.
enum SnapshotReason {
  DAILY
  SIGNUP
  TOPUP
  TRANSFER
  ORDER
  EXCHANGE
  SAVINGS
  BACKFILL
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AssetType {
  CRYPTO
  STOCK
  FIXED_INCOME
}

// Espelha CURRENCIES em packages/shared/src/types/enums.ts — mesmo padrão de
// sincronia manual já usado por TransferType/OrderStatus/AssetType.
enum Currency {
  BRL
  USD
  EUR
  GBP
  JPY
  CHF
  CAD
  AUD
  CNY
}

enum InvestorProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum Role {
  USER
  ADMIN
}
