generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  cpf                 String?              @unique
  phone               String?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  portfolio           Portfolio?
  refreshTokens       RefreshToken[]
  bankAccounts        BankAccount[]
  transfers           Transfer[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model Portfolio {
  id        String     @id @default(uuid())
  userId    String     @unique
  balance   Decimal    @default(0) @db.Decimal(15, 2)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]
}

model Position {
  id           String    @id @default(uuid())
  portfolioId  String
  ticker       String
  name         String
  type         AssetType
  quantity     Decimal   @db.Decimal(15, 8)
  avgPrice     Decimal   @db.Decimal(15, 2)
  currentValue Decimal   @db.Decimal(15, 2)
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, ticker])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  // Agrupa todos os tokens da mesma cadeia de rotação (WI-27: detecção de
  // reuso). Preservado a cada rotação, não muda até o próximo login.
  familyId   String
  // "Lembrar de mim": true = 30 dias, false = 7 dias (padrão). Decidido uma
  // vez no login e propagado a cada rotação da mesma família.
  rememberMe Boolean   @default(false)
  // null = token ativo. Setado quando o token é rotacionado (uso normal),
  // usado no logout, ou invalidado por troca de senha/reuso detectado. Um
  // token com revokedAt preenchido sendo reapresentado é o sinal de reuso.
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id         String   @id @default(uuid())
  userId     String
  bank       String
  agency     String
  account    String
  holderName String?
  type       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transfer {
  id              String         @id @default(uuid())
  userId          String
  status          TransferStatus @default(PENDING)
  type            TransferType
  amount          Decimal        @db.Decimal(15, 2)
  description     String?
  toAccountBank   String?
  toAccountAgency String?
  toAccountNumber String?
  toAccountHolder String?
  toAccountId     String?
  toAccountType   String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  failureReason   String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  assetId    String
  ticker     String
  side       OrderSide
  type       OrderType
  quantity   Decimal     @db.Decimal(15, 8)
  price      Decimal?    @db.Decimal(15, 2)
  status     OrderStatus @default(PENDING)
  avgPrice   Decimal?    @db.Decimal(15, 2)
  createdAt  DateTime    @default(now())
  executedAt DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, createdAt])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum TransferType {
  PIX
  TED
  DOC
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AssetType {
  CRYPTO
  STOCK
  FIXED_INCOME
}

enum Role {
  USER
  ADMIN
}
